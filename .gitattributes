# 默认统一为 LF：Windows 上写的脚本传到 Linux 板子才不会报 /bin/bash^M
* text=auto eol=lf

# 源码与脚本强制 LF
*.sh            text eol=lf
*.py            text eol=lf
*.c             text eol=lf
*.h             text eol=lf
*.cpp           text eol=lf
*.hpp           text eol=lf
*.cmake         text eol=lf
CMakeLists.txt  text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.launch.py     text eol=lf
*.md            text eol=lf

# Windows 专用脚本保持 CRLF
*.bat           text eol=crlf
*.ps1           text eol=crlf

# 二进制文件，不做任何转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.pgm   binary
