<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.2.0</version>
  <description>启动编排、参数、地图与 URDF。</description>
  <maintainer email="3553612993@qq.com">wuying</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_interfaces</exec_depend>
  <exec_depend>robot_base</exec_depend>
  <exec_depend>robot_lidar</exec_depend>
  <exec_depend>robot_raw_bridge</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <!-- M5 导航：navigation.launch.py 直接包含 nav2_bringup 的 bringup_launch.py，
       插件由 params 指定。逐项声明，避免换机器时只装了 nav2_bringup 的子集。 -->
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_dwb_controller</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_rviz_plugins</exec_depend>
  <exec_depend>robot_arm</exec_depend>
  <exec_depend>robot_vision</exec_depend>
  <exec_depend>robot_speech</exec_depend>
  <exec_depend>robot_task</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
