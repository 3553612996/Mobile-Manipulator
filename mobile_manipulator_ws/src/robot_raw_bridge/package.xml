<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_raw_bridge</name>
  <version>0.2.0</version>
  <description>测试用：订阅主机转发来的雷达/底盘原始字节，转换成 /scan、/odom 并接 SLAM。</description>
  <maintainer email="3553612993@qq.com">wuying</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>robot_interfaces</depend>
  <depend>robot_lidar</depend>
  <depend>robot_base</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
